    #loggerEl {
      position: absolute;
      z-index: 20000;
      top: 0;
      right: 0;
    }

    #loggerEl .logger-content{
      background-color: #fff;
      border: 1px solid #eee;
      border: 1px solid #eee;
      min-width: 200px;
      min-height: 300px;
      font-size: 14px;
      padding-left: 20px;
      width: 500px;
    }

    #loggerEl .logger-content .row-item{
      /* margin: 10px 0; */
      padding: 10px 0 ;
      border-bottom: 1px dashed #eee;
    }

    #loggerEl .row {
      padding: 5px 10px;
      margin-bottom: 5pm;
      border-bottom: 1px solid #eee;
    }

    #loggerEl .row em {
      font-style: normal;
      font-weight: bold;
    }

    #loggerEl legend {
      background-color: #eee;
      color: #000;
      padding: 5px;
    }

    .ci_container .ci_status {
      font-weight: bold;
      margin-left: 30px;
    }

    .ci_container .ci_duration {
      font-weight: bold;
    }

    #loggerEl a.toggle{
      color: #666;
    }

    #loggerEl .hidden {
      display: none;
    }

    #loggerEl #state-container b {
      display: block;
    }

    .pulsate {
      -webkit-animation: pulsate 1.5s ease-in-out;
      -webkit-animation-iteration-count: infinite; 
      opacity: 0.2;
    }

    @-webkit-keyframes pulsate {
      0% { 
        opacity: 0.5;
      }
      50% { 
        opacity: 1.0;
      }
      100% { 
        opacity: 0.3;
      }
    }

    #loggerEl .flash-message p{
      font-size: 14px;
      line-height: 18px;
    }

    #loggerEl .flash-message em {
      background-color: #eee;
      font-size: 0.7rem;
      font-family: monospace;
      font-style: normal;
      padding: 2px 4px;
    }
